<view class="container"><block wx:if="{{note}}"><view class="eyebrow">{{note.record.title}}</view><view class="title">{{note.record.question}}</view><view class="help wrap">盘面 {{note.id}}</view>
  <view class="panel" wx:for="{{blocks}}" wx:key="key"><view class="card-title">{{item.title}}</view><view class="rule">{{item.text}}</view><view wx:if="{{item.pillars}}" class="pillars"><view class="pillar" wx:for="{{item.pillars}}" wx:for-item="pillar" wx:key="name"><view class="tag">{{pillar.name}}</view><view>{{pillar.ganzhi}}</view><view class="help">{{pillar.wuxing}}</view><view class="help">{{pillar.nayin}}</view></view></view></view>
  <view class="panel" wx:if="{{cards.length}}"><view class="help">{{note.record.facts.tarotRules.spreadName}} · 韦特 78 张</view><view class="tarot-grid"><view class="tarot" wx:for="{{cards}}" wx:key="id" data-index="{{index}}" bindtap="flip"><view class="help">{{item.position}}</view><block wx:if="{{item.open}}"><image src="{{item.image}}" mode="aspectFit" class="{{item.orientation==='逆位'?'reversed':''}}"/><view>{{item.name}} · {{item.orientation}}</view><view class="help">{{item.gloss}}</view></block><view wx:else class="back">清和 · 翻开</view></view></view><button wx:if="{{!allRevealed}}" data-index="-1" bindtap="flip" disabled="{{busy}}">全部翻开</button></view>
  <view class="panel" wx:if="{{lines.length}}"><view wx:for="{{lines}}" wx:key="position"><view class="line">{{item.symbol}} {{item.moving?'◯':''}}</view><view class="help">{{item.position}} 爻 · {{item.detail.liuShen}} · {{item.detail.liuQin}} {{item.detail.ganZhi}} {{item.detail.isShi?'世':''}}{{item.detail.isYing?'应':''}}<text wx:if="{{item.changed}}"> → {{item.changed.liuQin}} {{item.changed.ganZhi}}</text></view></view></view>
  <view wx:if="{{palaces.length}}" class="palaces"><view class="palace" wx:for="{{palaces}}" wx:key="index"><view>{{item.name}} · {{item.heavenlyStem}}{{item.earthlyBranch}} {{item.isBodyPalace?'身宫':''}}</view><view class="help">{{item.stars}}</view><view class="help">大限 {{item.decadal.range[0]}}—{{item.decadal.range[1]}}</view></view></view>
  <button bindtap="toggleFacts">{{showFacts?'收起':'查看'}}完整计算依据</button><view wx:if="{{showFacts}}" class="panel json" selectable>{{rawFacts}}</view>
  <view class="panel"><view class="card-title">AI 解读</view><view class="answer" selectable>{{note.answer||'尚未调用模型。请先核对盘面，再开始解读。'}}</view>
    <block wx:for="{{historyView}}" wx:key="key"><view class="divider"/><view class="tag">{{item.role==='user'?'你的追问':'清和'}}</view><view class="answer" selectable>{{item.content}}</view></block>
    <view wx:if="{{partial}}" class="notice answer" selectable>{{partial}}<view wx:if="{{error}}" class="help">以上是未完成片段，未作为完整回答保存。</view></view>
    <button wx:if="{{needsPhoto}}" bindtap="choosePhoto">重新选择手掌照片</button>
    <button wx:if="{{!note.answer}}" class="primary" bindtap="interpret" disabled="{{busy||!allRevealed||needsPhoto}}" loading="{{busy}}">结合此盘 AI 解读</button>
    <block wx:else><text class="label">围绕同一盘继续追问</text><textarea value="{{question}}" bindinput="changeQuestion" maxlength="4000"/><button class="primary" bindtap="followup" disabled="{{busy}}" loading="{{busy}}">发送追问</button></block>
    <view class="help">调用 AI 需要六位访问码；问题、盘面及本次对话会发送给管理员配置的模型，可能产生费用。</view>
  </view><view class="actions"><button bindtap="copy">复制结果</button><button bindtap="export">导出札记</button></view></block><view class="error">{{error}}</view></view>
