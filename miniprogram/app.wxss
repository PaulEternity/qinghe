page{background:#f5f1e8;color:#303b38;font-family:-apple-system,"PingFang SC",sans-serif;font-size:29rpx;line-height:1.7}view,text,input,textarea,button{box-sizing:border-box}.container{padding:32rpx 28rpx 80rpx}.brand{font-family:serif;font-size:70rpx;letter-spacing:14rpx;color:#29544b}.eyebrow{font-size:23rpx;letter-spacing:5rpx;color:#8c704b}.title{font-size:43rpx;font-family:serif;margin:16rpx 0}.subtitle,.help{font-size:25rpx;color:#69756d}.help{margin:16rpx 0}.panel,.card{background:#fffdf7;border:1rpx solid #dedbcb;border-radius:20rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 5rpx 18rpx #334a3905}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.grid .card{margin:0;min-height:200rpx}.glyph{color:#9a7850;font-family:serif;font-size:48rpx}.card-title{font-size:32rpx;font-weight:600}.nav,.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin:26rpx 0}.nav button,.actions button{margin:0;flex:1;min-width:180rpx}button{background:#ece8dc;color:#305348;border:0;border-radius:12rpx;font-size:27rpx;margin:20rpx 0;padding:8rpx 16rpx}button::after{border:0}button.primary{background:#31594e;color:#fffdf7}button.danger{color:#993e35}button[disabled]{opacity:.45}.label{display:block;margin:24rpx 0 12rpx;font-weight:500}input,textarea,.picker{width:100%;background:#f8f6ee;border:1rpx solid #dcd8ca;border-radius:10rpx;padding:18rpx;font-size:28rpx;min-height:80rpx}textarea{height:200rpx}.error{color:#a14332;white-space:pre-wrap;margin:18rpx 0}.answer{white-space:pre-wrap;line-height:1.95}.rule{font-size:25rpx;white-space:pre-wrap;color:#637066}.row{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:20rpx 0}.wrap{overflow-wrap:anywhere;word-break:break-all}.tag{font-size:23rpx;color:#85734e}.divider{height:1rpx;background:#dedbcb;margin:28rpx 0}.tarot-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.tarot{padding:18rpx;text-align:center;background:#efeadb;border-radius:14rpx}.tarot image{width:100%;height:340rpx}.tarot .back{height:340rpx;display:flex;align-items:center;justify-content:center;background:#31594e;border:8rpx double #bda373;border-radius:12rpx;color:#d4bc83;font-family:serif;font-size:50rpx}.reversed{transform:rotate(180deg)}.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;text-align:center}.pillar{background:#f3efe3;padding:18rpx 6rpx;border-radius:10rpx}.palaces{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.palace{padding:16rpx;background:#f3efe3;border-radius:12rpx}.line{font-family:monospace;font-size:38rpx;letter-spacing:10rpx;text-align:center}.json{white-space:pre-wrap;word-break:break-all;font-family:monospace;font-size:23rpx}.notice{background:#ede8d5;padding:18rpx;border-radius:10rpx}.coin{display:inline-block;border-radius:50%;background:#b69b56;padding:16rpx;margin-right:12rpx;color:#fff}.footer{margin-top:40rpx;color:#8a8a79;font-size:23rpx;text-align:center}
