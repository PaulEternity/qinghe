# 复制为 .env 后填入你的服务配置；不要把真实 Key 发到聊天或提交到 Git。
# BASE_URL 是包含 /v1 的 API 根地址，需支持 POST /chat/completions。
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=
MODEL_NAME=
PORT=3187

# 本机独立 MySQL 应用账号，不能使用无密码 root。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=qinghe
MYSQL_USER=qinghe
MYSQL_PASSWORD=
