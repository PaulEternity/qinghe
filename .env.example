# 复制为 .env 后填入你的服务配置；不要把真实 Key 发到聊天或提交到 Git。
# BASE_URL 是包含 /v1 的 API 根地址，需支持 POST /chat/completions。
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=
MODEL_NAME=
# 图片模型独立配置；不填写时手相 AI 不可用，不回退文字模型。
VISION_MODEL_BASE_URL=
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=
# 云端必填：用 randomBytes(32).toString('hex') 生成，所有部署必须使用相同值。
# 本地不填时，自动保存到被 Git 忽略的 .local/model-config.key。
MODEL_CONFIG_SECRET=
# 微信 AppSecret 只保存在服务端，不能写入 miniprogram/。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PORT=3187

# 本机独立 MySQL 应用账号，不能使用无密码 root。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=qinghe
MYSQL_USER=qinghe
MYSQL_PASSWORD=

# Render + TiDB：本地保留 local。云端必须改为 cloud，且启用数据库 TLS。
APP_MODE=local
MYSQL_SSL=false
# 仅同 VPC 的 RFC1918 私网 IPv4 数据库未启用 TLS 时，配合 MYSQL_SSL=false 显式开启。
MYSQL_ALLOW_INSECURE_PRIVATE=false
# PUBLIC_ORIGIN=https://你的服务.onrender.com
# Render 自动提供 RENDER_EXTERNAL_URL，使用默认域名时无需另填 PUBLIC_ORIGIN。
# ADMIN_INITIAL_PASSWORD=首次云端管理员密码，12—128 位
# AI_INITIAL_CODE=首次云端六位数字访问码
# 云端这两项仅用于数据库首次初始化，后续修改请使用管理员页面。
