# 复制为 .env 后填入你的服务配置；不要把真实 Key 发到聊天或提交到 Git。
# BASE_URL 是包含 /v1 的 API 根地址，需支持 POST /chat/completions。
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=
MODEL_NAME=
PORT=3187

# 本机独立 MySQL 应用账号，不能使用无密码 root。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=qinghe
MYSQL_USER=qinghe
MYSQL_PASSWORD=

# Render + TiDB：本地保留 local。云端必须改为 cloud，且启用数据库 TLS。
APP_MODE=local
MYSQL_SSL=false
# PUBLIC_ORIGIN=https://你的服务.onrender.com
# Render 自动提供 RENDER_EXTERNAL_URL，使用默认域名时无需另填 PUBLIC_ORIGIN。
# ADMIN_INITIAL_PASSWORD=首次云端管理员密码，12—128 位
# AI_INITIAL_CODE=首次云端六位数字访问码
# 云端这两项仅用于数据库首次初始化，后续修改请使用管理员页面。
